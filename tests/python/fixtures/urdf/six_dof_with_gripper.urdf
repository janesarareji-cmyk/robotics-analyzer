<?xml version="1.0"?>
<robot name="six_dof_with_gripper">
  <link name="base">
    <inertial><origin xyz="0 0 0.05" rpy="0.1 -0.2 0.3"/><mass value="1.0"/><inertia ixx="0.01" ixy="0.001" ixz="0" iyy="0.02" iyz="0" izz="0.03"/></inertial>
    <visual><geometry><mesh filename="../meshes/cube.stl" scale="0.5 0.5 0.5"/></geometry></visual>
  </link>
  <link name="l1">
