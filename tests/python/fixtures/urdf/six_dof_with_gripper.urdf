  <joint name="j1" type="revolute"><parent link="base"/><child link="l1"/><origin xyz="0 0 0.2" rpy="0 0 0.3"/><axis xyz="0 0 1"/><limit lower="-3.0" upper="3.0" effort="10" velocity="1"/></joint>
  <joint name="j2" type="revolute"><parent link="l1"/><child link="l2"/><origin xyz="0.05 0 0.15" rpy="0.2 0 0"/><axis xyz="0 1 0"/><limit lower="-3.0" upper="3.0" effort="10" velocity="1"/></joint>
  <joint name="j3" type="revolute"><parent link="l2"/><child link="l3"/><origin xyz="0.3 0 0" rpy="0 0.4 0"/><axis xyz="0 1 0"/><limit lower="-3.0" upper="3.0" effort="10" velocity="1"/></joint>
  <joint name="j4" type="revolute"><parent link="l3"/><child link="l4"/><origin xyz="0.25 0.02 0" rpy="0 0 -0.5"/><axis xyz="1 0 0"/><limit lower="-3.0" upper="3.0" effort="10" velocity="1"/></joint>
  <joint name="j5" type="revolute"><parent link="l4"/><child link="l5"/><origin xyz="0 0 0.1" rpy="0.3 -0.2 0"/><axis xyz="0 1 0"/><limit lower="-3.0" upper="3.0" effort="10" velocity="1"/></joint>
  <joint name="j6" type="revolute"><parent link="l5"/><child link="l6"/><origin xyz="0.05 0 0.05" rpy="0 0 0.1"/><axis xyz="0.6 0 0.8"/><limit lower="-3.0" upper="3.0" effort="10" velocity="1"/></joint>
  <joint name="jf_l" type="prismatic"><parent link="l6"/><child link="finger_l"/><origin xyz="0 0.02 0.05" rpy="0 0 0.1"/><axis xyz="0 1 0"/><limit lower="0" upper="0.04" effort="10" velocity="0.1"/></joint>
  <joint name="jf_r" type="prismatic"><parent link="l6"/><child link="finger_r"/><origin xyz="0 -0.02 0.05" rpy="0 0 0.1"/><axis xyz="0 -1 0"/><limit lower="0" upper="0.04" effort="10" velocity="0.1"/><mimic joint="jf_l" multiplier="1" offset="0"/></joint>
</robot>
