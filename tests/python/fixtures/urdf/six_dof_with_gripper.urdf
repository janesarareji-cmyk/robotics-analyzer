    <visual><geometry><mesh filename="../meshes/cube.stl" scale="0.5 0.5 0.5"/></geometry></visual>
  </link>
  <link name="l2">
    <inertial><origin xyz="0.15 0 0.02" rpy="0.1 -0.2 0.3"/><mass value="3.0"/><inertia ixx="0.01" ixy="0.001" ixz="0" iyy="0.02" iyz="0" izz="0.03"/></inertial>
    <visual><geometry><mesh filename="../meshes/cube.stl" scale="0.5 0.5 0.5"/></geometry></visual>
  </link>
  <link name="l3">
    <inertial><origin xyz="0.1 0.02 0" rpy="0.1 -0.2 0.3"/><mass value="1.5"/><inertia ixx="0.01" ixy="0.001" ixz="0" iyy="0.02" iyz="0" izz="0.03"/></inertial>
    <visual><geometry><mesh filename="../meshes/cube.stl" scale="0.5 0.5 0.5"/></geometry></visual>
  </link>
  <link name="l4">
    <inertial><origin xyz="0 0 0.08" rpy="0.1 -0.2 0.3"/><mass value="1.2"/><inertia ixx="0.01" ixy="0.001" ixz="0" iyy="0.02" iyz="0" izz="0.03"/></inertial>
    <visual><geometry><mesh filename="../meshes/cube.stl" scale="0.5 0.5 0.5"/></geometry></visual>
  </link>
  <link name="l5">
    <inertial><origin xyz="0.02 0 0.04" rpy="0.1 -0.2 0.3"/><mass value="0.8"/><inertia ixx="0.01" ixy="0.001" ixz="0" iyy="0.02" iyz="0" izz="0.03"/></inertial>
    <visual><geometry><mesh filename="../meshes/cube.stl" scale="0.5 0.5 0.5"/></geometry></visual>
  </link>
  <link name="l6">
    <inertial><origin xyz="0 0.01 0.03" rpy="0.1 -0.2 0.3"/><mass value="0.6"/><inertia ixx="0.01" ixy="0.001" ixz="0" iyy="0.02" iyz="0" izz="0.03"/></inertial>
    <visual><geometry><mesh filename="../meshes/cube.stl" scale="0.5 0.5 0.5"/></geometry></visual>
  </link>
  <link name="finger_l">
    <inertial><origin xyz="0 0.01 0.02" rpy="0.1 -0.2 0.3"/><mass value="0.1"/><inertia ixx="0.01" ixy="0.001" ixz="0" iyy="0.02" iyz="0" izz="0.03"/></inertial>
    <visual><geometry><mesh filename="../meshes/cube.stl" scale="0.5 0.5 0.5"/></geometry></visual>
  </link>
  <link name="finger_r">
    <inertial><origin xyz="0 -0.01 0.02" rpy="0.1 -0.2 0.3"/><mass value="0.12"/><inertia ixx="0.01" ixy="0.001" ixz="0" iyy="0.02" iyz="0" izz="0.03"/></inertial>
    <visual><geometry><mesh filename="../meshes/cube.stl" scale="0.5 0.5 0.5"/></geometry></visual>
