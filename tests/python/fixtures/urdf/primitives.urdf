<?xml version="1.0"?>
<robot name="prims">
  <material name="blue"><color rgba="0 0 1 1"/></material>
  <link name="base">
    <visual><geometry><box size="0.2 0.1 0.05"/></geometry></visual>
    <collision><geometry><box size="0.2 0.1 0.05"/></geometry></collision>
  </link>
  <link name="l1">
    <visual>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <geometry><cylinder radius="0.05" length="0.5"/></geometry>
      <material name="blue"/>
    </visual>
  </link>
  <link name="l2">
    <visual>
      <origin xyz="0.1 0 0" rpy="0 1.5707963 0"/>
      <geometry><sphere radius="0.06"/></geometry>
      <material name="inline"><color rgba="1 0 0 0.5"/></material>
    </visual>
    <visual><geometry><sphere radius="0.01"/></geometry></visual>
  </link>
  <joint name="j1" type="revolute">
    <parent link="base"/><child link="l1"/><origin xyz="0 0 0.05"/><axis xyz="0 0 1"/>
    <limit lower="-3" upper="3" effort="5" velocity="1"/>
  </joint>
  <joint name="j2" type="revolute">
    <parent link="l1"/><child link="l2"/><origin xyz="0 0 0.5"/><axis xyz="0 1 0"/>
    <limit lower="-3" upper="3" effort="5" velocity="1"/>
  </joint>
</robot>
